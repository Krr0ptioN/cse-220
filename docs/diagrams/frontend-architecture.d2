# Frontend Architecture
# Next.js route composition and runtime dependencies

direction: down

routes: "App Router Routes" {
  shape: rectangle
  style: {
    fill: "#E3F2FD"
    stroke: "#1976D2"
    stroke-width: 2
    border-radius: 8
  }

  public: "Public Discovery\n/, /search, /map" {
    shape: rectangle
    style: {
      fill: "#BBDEFB"
      stroke: "#1565C0"
      stroke-width: 2
      border-radius: 4
      font-size: 18
      bold: true
    }
  }

  restaurant: "Restaurant Detail\n/restaurants\n/[slug], /menu, /reviews" {
    shape: rectangle
    style: {
      fill: "#BBDEFB"
      stroke: "#1565C0"
      stroke-width: 2
      border-radius: 4
      font-size: 18
      bold: true
    }
  }

  account: "Account Flows\n/auth/login, /auth/register\n/profile, favorites, reviews" {
    shape: rectangle
    style: {
      fill: "#BBDEFB"
      stroke: "#1565C0"
      stroke-width: 2
      border-radius: 4
      font-size: 18
      bold: true
    }
  }

  owner: "Owner Dashboard\n/owner/dashboard\nrestaurants, replies, analytics" {
    shape: rectangle
    style: {
      fill: "#BBDEFB"
      stroke: "#1565C0"
      stroke-width: 2
      border-radius: 4
      font-size: 18
      bold: true
    }
  }
}

components: "UI Composition" {
  shape: rectangle
  style: {
    fill: "#C8E6C9"
    stroke: "#388E3C"
    stroke-width: 2
    border-radius: 8
  }

  primitives: "Shared Primitives\nButton, Card, Input,\nModal, StarRating" {
    shape: rectangle
    style: {
      fill: "#E8F5E9"
      stroke: "#388E3C"
      stroke-width: 2
      border-radius: 4
      font-size: 18
    }
  }

  feature_ui: "Feature Components\nRestaurantCard, filters,\nReviewCard, ReviewForm, MapView" {
    shape: rectangle
    style: {
      fill: "#E8F5E9"
      stroke: "#388E3C"
      stroke-width: 2
      border-radius: 4
      font-size: 18
      bold: true
    }
  }

  owner_ui: "Owner Surfaces\nlisting editor,\nreview replies,\nanalytics charts" {
    shape: rectangle
    style: {
      fill: "#E8F5E9"
      stroke: "#388E3C"
      stroke-width: 2
      border-radius: 4
      font-size: 18
    }
  }
}

runtime: "Client Runtime" {
  shape: rectangle
  style: {
    fill: "#FFF9C4"
    stroke: "#F9A825"
    stroke-width: 2
    border-radius: 8
  }

  api_client: "API Client\nfetch wrappers,\nerror handling,\nresponse normalization" {
    shape: rectangle
    style: {
      fill: "#FFFDE7"
      stroke: "#F9A825"
      stroke-width: 2
      border-radius: 4
      font-size: 18
      bold: true
    }
  }

  auth_service: "Auth Service\nrole-aware redirects,\ntoken/session state" {
    shape: rectangle
    style: {
      fill: "#FFFDE7"
      stroke: "#F9A825"
      stroke-width: 2
      border-radius: 4
      font-size: 18
    }
  }

  stores: "Local Stores\nuser, filters,\nselected restaurant, UI state" {
    shape: rectangle
    style: {
      fill: "#FFFDE7"
      stroke: "#F9A825"
      stroke-width: 2
      border-radius: 4
      font-size: 18
    }
  }
}

backend: "Django API\nREST endpoints for restaurants,\nreviews, files, owner analytics" {
  shape: rectangle
  style: {
    fill: "#FFECB3"
    stroke: "#F57C00"
    stroke-width: 2
    border-radius: 8
    font-size: 20
    bold: true
  }
}

routes -> components: "compose pages"
components -> runtime: "load data and submit actions"
runtime -> backend: "REST JSON"
