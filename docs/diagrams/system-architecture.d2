# System Architecture
# FlavorMap - Restaurant Review Platform

direction: down

client_layer: "Presentation Layer" {
  shape: rectangle
  style: {
    fill: "#E3F2FD"
    stroke: "#1976D2"
    stroke-width: 2
    border-radius: 8
  }

  browser: "Browser" {
    shape: rectangle
    style: {
      fill: "#FFFFFF"
      stroke: "#1976D2"
      stroke-width: 2
      border-radius: 4
      font-size: 20
    }
  }

  nextjs: "Next.js 16 App\nApp Router, pages,\ncomponents, client services" {
    shape: rectangle
    style: {
      fill: "#BBDEFB"
      stroke: "#1565C0"
      stroke-width: 2
      border-radius: 4
      font-size: 20
      bold: true
    }
  }
}

api_layer: "Application Layer" {
  shape: rectangle
  style: {
    fill: "#C8E6C9"
    stroke: "#388E3C"
    stroke-width: 2
    border-radius: 8
  }

  auth: "Auth + Permissions\nJWT, roles, ownership checks" {
    shape: rectangle
    style: {
      fill: "#E8F5E9"
      stroke: "#388E3C"
      stroke-width: 2
      border-radius: 4
      font-size: 18
    }
  }

  api: "Django REST Framework\n(djangorestframework)\nserializers, views, permissions" {
    shape: rectangle
    style: {
      fill: "#E8F5E9"
      stroke: "#388E3C"
      stroke-width: 2
      border-radius: 4
      font-size: 18
      bold: true
    }
  }

  services: "Service + Repository Layer\nvalidation, transactions,\nrating aggregation, URLs" {
    shape: rectangle
    style: {
      fill: "#E8F5E9"
      stroke: "#388E3C"
      stroke-width: 2
      border-radius: 4
      font-size: 18
    }
  }
}

data_layer: "Data and File Storage" {
  shape: rectangle
  style: {
    fill: "#F8F1FF"
    stroke: "#7B1FA2"
    stroke-width: 2
    border-radius: 8
  }

  postgresql: "PostgreSQL\nrelational data,\nratings, ownership" {
    shape: cylinder
    style: {
      fill: "#D1C4E9"
      stroke: "#7B1FA2"
      stroke-width: 2
      font-size: 18
      bold: true
    }
  }

  minio: "MinIO Object Storage\nrestaurant photos,\nfile objects" {
    shape: cylinder
    style: {
      fill: "#FFE0B2"
      stroke: "#EF6C00"
      stroke-width: 2
      font-size: 18
      bold: true
    }
  }
}

client_layer -> api_layer: "HTTPS + REST JSON"
api_layer -> data_layer: "Django ORM + file operations"
