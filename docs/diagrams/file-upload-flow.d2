# File Upload Flow
# MinIO presigned URL pattern without background workers

direction: down

client: Client {
  shape: rectangle
  style: {
    fill: "#E3F2FD"
    stroke: "#1976D2"
    stroke-width: 2
    border-radius: 8
    font-size: 20
    bold: true
  }
}

api: Django API {
  shape: rectangle
  style: {
    fill: "#C8E6C9"
    stroke: "#388E3C"
    stroke-width: 2
    border-radius: 8
  }

  validate: "Validate Request\ncontent type, size, purpose" {
    shape: rectangle
    style: {
      fill: "#E8F5E9"
      stroke: "#388E3C"
      stroke-width: 2
      border-radius: 4
      font-size: 18
    }
  }

  generate: "Generate Presigned URL\nobject key + upload id" {
    shape: rectangle
    style: {
      fill: "#E8F5E9"
      stroke: "#388E3C"
      stroke-width: 2
      border-radius: 4
      font-size: 18
      bold: true
    }
  }

  confirm: "Confirm Upload\ncreate file record" {
    shape: rectangle
    style: {
      fill: "#E8F5E9"
      stroke: "#388E3C"
      stroke-width: 2
      border-radius: 4
      font-size: 18
      bold: true
    }
  }
}

minio: MinIO Object Storage {
  shape: cylinder
  style: {
    fill: "#FFE0B2"
    stroke: "#EF6C00"
    stroke-width: 2
    font-size: 18
    bold: true
  }
}

db: PostgreSQL {
  shape: cylinder
  style: {
    fill: "#D1C4E9"
    stroke: "#7B1FA2"
    stroke-width: 2
    font-size: 18
    bold: true
  }
}

client -> api.validate: "1. POST /files/upload-url\nfilename, type, size, purpose"
api.validate -> api.generate: "2. validate metadata"
api.generate -> minio: "3. request presigned PUT URL"
minio -> api.generate: "4. signed URL"
api.generate -> client: "5. upload_id + presigned_url"
client -> minio: "6. PUT file bytes directly"
minio -> client: "7. 200 OK"
client -> api.confirm: "8. POST /files\nupload_id + object_key"
api.confirm -> minio: "9. verify object metadata"
api.confirm -> db: "10. INSERT file row"
api.confirm -> client: "11. file_id + public URL"
